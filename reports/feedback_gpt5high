## One-shot SQL script: production hardening and indexing
```sql
-- 1) Enable RLS on key tables
ALTER TABLE public.images ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.prompts ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.project_tasks ENABLE ROW LEVEL SECURITY;

-- 2) Drop permissive public mutation policies if they exist
DO $$
BEGIN
  PERFORM 1 FROM pg_policies WHERE schemaname = 'public' AND tablename = 'images' AND policyname = 'Allow public insert access to images';
  IF FOUND THEN EXECUTE 'DROP POLICY "Allow public insert access to images" ON public.images'; END IF;
  PERFORM 1 FROM pg_policies WHERE schemaname = 'public' AND tablename = 'images' AND policyname = 'Allow public update access to images';
  IF FOUND THEN EXECUTE 'DROP POLICY "Allow public update access to images" ON public.images'; END IF;
  PERFORM 1 FROM pg_policies WHERE schemaname = 'public' AND tablename = 'images' AND policyname = 'Allow public delete access to images';
  IF FOUND THEN EXECUTE 'DROP POLICY "Allow public delete access to images" ON public.images'; END IF;

  PERFORM 1 FROM pg_policies WHERE schemaname = 'public' AND tablename = 'prompts' AND policyname = 'Allow public insert access to prompts';
  IF FOUND THEN EXECUTE 'DROP POLICY "Allow public insert access to prompts" ON public.prompts'; END IF;
  PERFORM 1 FROM pg_policies WHERE schemaname = 'public' AND tablename = 'prompts' AND policyname = 'Allow public update access to prompts';
  IF FOUND THEN EXECUTE 'DROP POLICY "Allow public update access to prompts" ON public.prompts'; END IF;
  PERFORM 1 FROM pg_policies WHERE schemaname = 'public' AND tablename = 'prompts' AND policyname = 'Allow public delete access to prompts';
  IF FOUND THEN EXECUTE 'DROP POLICY "Allow public delete access to prompts" ON public.prompts'; END IF;
END $$;

-- 3) Read policies (public can read)
CREATE POLICY IF NOT EXISTS "public_read_images" ON public.images FOR SELECT USING (true);
CREATE POLICY IF NOT EXISTS "public_read_prompts" ON public.prompts FOR SELECT USING (true);
CREATE POLICY IF NOT EXISTS "public_read_project_tasks" ON public.project_tasks FOR SELECT USING (true);

-- 4) Mutation policies (choose one path)
-- Path A: lock down to service role only (Edge Functions). No client-side writes.
REVOKE INSERT, UPDATE, DELETE ON public.images FROM anon, authenticated;
REVOKE INSERT, UPDATE, DELETE ON public.prompts FROM anon, authenticated;

-- If you need temporary authenticated writes (Path B), replace the REVOKEs above with ownership policies like:
-- CREATE POLICY IF NOT EXISTS "user_insert_images" ON public.images FOR INSERT WITH CHECK (auth.role() = 'authenticated');
-- CREATE POLICY IF NOT EXISTS "user_update_own_images" ON public.images FOR UPDATE USING (user_id = auth.uid());
-- CREATE POLICY IF NOT EXISTS "user_insert_prompts" ON public.prompts FOR INSERT WITH CHECK (auth.role() = 'authenticated');
-- CREATE POLICY IF NOT EXISTS "user_update_own_prompts" ON public.prompts FOR UPDATE USING (user_id = auth.uid());

-- 5) Performance indexes (match frequent filters/sorts)
CREATE INDEX IF NOT EXISTS idx_images_created_at ON public.images (created_at);
CREATE INDEX IF NOT EXISTS idx_images_theme ON public.images (theme);
CREATE INDEX IF NOT EXISTS idx_images_country ON public.images (country);
CREATE INDEX IF NOT EXISTS idx_images_continent ON public.images ("1_where_continent");
CREATE INDEX IF NOT EXISTS idx_images_year ON public.images (year);
CREATE INDEX IF NOT EXISTS idx_images_cost ON public.images (cost);
CREATE INDEX IF NOT EXISTS idx_images_real_event ON public.images (real_event);
CREATE INDEX IF NOT EXISTS idx_images_people_count ON public.images (approx_people_count);
CREATE INDEX IF NOT EXISTS idx_images_confidence ON public.images (confidence);
CREATE INDEX IF NOT EXISTS idx_images_optimized_url_not_null ON public.images ((optimized_image_url IS NOT NULL));

-- 6) Optional: future cleanup for inline binary (after migrating all images to object storage)
-- ALTER TABLE public.images DROP COLUMN IF EXISTS binary;
```

